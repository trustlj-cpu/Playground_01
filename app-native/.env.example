# Content API (static JSON written by site/build.js on every web deploy)
EXPO_PUBLIC_API_BASE=https://dailydropnewspaper.com/app/v1/
# 1 = use the bundled fixtures in fixtures/app/v1 instead of the network (development only)
EXPO_PUBLIC_USE_FIXTURES=0
# 1 = show Settings → Account and sync bookmarks with the web account (needs the server change in README.md)
EXPO_PUBLIC_ACCOUNT_SYNC=0
