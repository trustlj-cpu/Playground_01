{
  "expo": {
    "name": "DailyDrop",
    "slug": "dailydrop",
    "scheme": "dailydrop",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ece4d8",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/REPLACE-WITH-EAS-PROJECT-ID",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "com.dailydrop.news",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:dailydropnewspaper.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dailydrop.news",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ece4d8"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ece4d8",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#14130f"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
