{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_API_BASE": "https://dailydropnewspaper.com/app/v1/" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_API_BASE": "https://dailydropnewspaper.com/app/v1/" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_BASE": "https://dailydropnewspaper.com/app/v1/" }
    }
  },
  "submit": {
    "production": {}
  }
}
