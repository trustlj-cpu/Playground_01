{
  "appId": "kr.dailydrop.app",
  "appName": "DailyDrop",
  "webDir": "www",
  "backgroundColor": "#ece4d8",
  "server": {
    "url": "https://dailydropnewspaper.com",
    "allowNavigation": [
      "dailydropnewspaper.com",
      "www.dailydropnewspaper.com",
      "dailydrop.kr",
      "www.dailydrop.kr"
    ],
    "errorPath": "index.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#ece4d8",
    "webContentsDebuggingEnabled": true
  },
  "android": {
    "backgroundColor": "#ece4d8"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "loggingBehavior": "debug"
}